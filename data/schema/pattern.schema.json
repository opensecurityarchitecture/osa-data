{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensecurityarchitecture.org/schema/pattern.schema.json",
  "title": "OSA Security Architecture Pattern",
  "description": "Schema for Open Security Architecture patterns with NIST control mappings",
  "type": "object",

  "required": ["id", "title", "metadata", "controls"],

  "properties": {
    "$schema": {
      "type": "string",
      "description": "Reference to this schema"
    },

    "id": {
      "type": "string",
      "pattern": "^SP-[0-9]{3}(\\.[0-9]+)?$",
      "description": "Pattern identifier (e.g., SP-011, SP-003.1)",
      "examples": ["SP-011", "SP-003.1"]
    },

    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "URL-friendly identifier"
    },

    "joomla_id": {
      "type": "integer",
      "description": "Original Joomla article ID for reference"
    },

    "title": {
      "type": "string",
      "description": "Human-readable pattern title"
    },

    "description": {
      "type": "string",
      "description": "Brief description/summary of the pattern"
    },

    "url": {
      "type": "string",
      "format": "uri",
      "description": "Canonical URL on opensecurityarchitecture.org"
    },

    "metadata": {
      "type": "object",
      "required": ["release", "status"],
      "properties": {
        "release": {
          "type": "string",
          "description": "OSA release version (e.g., 08.02)"
        },
        "classification": {
          "type": "string",
          "description": "Pattern category/classification"
        },
        "status": {
          "type": "string",
          "enum": ["active", "draft", "published", "reserved", "deprecated"],
          "description": "Publication status"
        },
        "type": {
          "type": "string",
          "enum": ["pattern", "module", "reference"],
          "default": "pattern",
          "description": "Pattern type - modules are reusable components, reference is the style guide"
        },
        "datePublished": {
          "type": "string",
          "format": "date",
          "description": "Original publication date"
        },
        "dateModified": {
          "type": "string",
          "format": "date",
          "description": "Last modification date"
        },
        "authors": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Pattern authors (pseudonyms)"
        },
        "reviewers": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Pattern reviewers (pseudonyms)"
        },
        "provenance": {
          "type": "string",
          "description": "Origin and real-world experience behind the pattern"
        },
        "contributors": {
          "type": "array",
          "description": "Organisations outside the founders who contributed part of the pattern, and what they contributed",
          "items": {
            "type": "object",
            "required": ["name", "contribution"],
            "properties": {
              "name": {"type": "string"},
              "url": {"type": "string", "format": "uri"},
              "people": {"type": "array", "items": {"type": "string"}},
              "contribution": {"type": "string"}
            }
          }
        },
        "previousVersions": {
          "type": "array",
          "description": "Earlier releases kept in data/patterns/archive/",
          "items": {
            "type": "object",
            "required": ["release", "file"],
            "properties": {
              "release": {"type": "string"},
              "dateModified": {"type": "string", "format": "date"},
              "file": {"type": "string", "description": "Path relative to data/patterns/"},
              "note": {"type": "string"}
            }
          }
        },
        "supersededBy": {
          "type": "string",
          "description": "Pattern ID that replaces this one (deprecated or archived patterns)"
        },
        "archived": {
          "type": "object",
          "description": "Set on a copy kept in data/patterns/archive/",
          "properties": {
            "date": {"type": "string", "format": "date"},
            "supersededByRelease": {"type": "string"},
            "note": {"type": "string"}
          }
        },
        "implementations": {
          "type": "array",
          "description": "Places the pattern has been built, as reported by the people who built it, most often through the implementation report template on osa-data. Quality dimension 4, questions 4.4 and 4.5",
          "items": {
            "type": "object",
            "required": ["reported", "source", "tested"],
            "additionalProperties": false,
            "properties": {
              "reported": {"type": "string", "format": "date", "description": "When the report arrived"},
              "source": {"type": "string", "format": "uri", "description": "The report: an issue on osa-data or another public record"},
              "organisation": {"type": "string", "description": "Named only with the reporter's consent"},
              "sector": {"type": "string"},
              "size": {"type": "string", "enum": ["small", "medium", "large"], "description": "Under 250 people, 250 to 5000, over 5000"},
              "independent": {"type": "boolean", "description": "Built by someone other than the pattern's authors"},
              "tested": {"type": "string", "description": "How the build was tested, such as a penetration test, an audit or an incident; \"not yet\" for a new build"},
              "lessons": {"type": "string", "description": "What the builders changed or would change, and whether the pattern now says it"}
            }
          }
        }
      }
    },

    "diagram": {
      "type": "object",
      "description": "Architecture diagram references",
      "properties": {
        "svg": {
          "type": "string",
          "description": "Path to SVG diagram (with hyperlinked controls)"
        },
        "png": {
          "type": "string",
          "description": "Path to PNG fallback"
        }
      }
    },

    "legend": {
      "type": "string",
      "description": "Explanation of the diagram and key control significance"
    },

    "content": {
      "type": "object",
      "description": "Main pattern content sections",
      "properties": {
        "description": {
          "type": "string",
          "description": "Full description of the pattern context and use case"
        },
        "keyControlAreas": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Key areas requiring control consideration"
        },
        "assumptions": {
          "type": "string",
          "description": "Assumptions made in the pattern"
        },
        "typicalChallenges": {
          "type": "string",
          "description": "Common implementation challenges"
        },
        "indications": {
          "type": "string",
          "description": "When to use this pattern"
        },
        "contraIndications": {
          "type": "string",
          "description": "When NOT to use this pattern"
        },
        "threatResistance": {
          "type": "string",
          "description": "Threats addressed by this pattern"
        },
        "preconditions": {
          "type": "array",
          "description": "The assumptions the pattern relies on, one per entry. Each describes the environment or names the building block that carries a threat. Structured form of assumptions. Quality dimension 1, question 1.3, and dimension 3, question 3.4",
          "items": {
            "type": "object",
            "required": ["kind", "statement"],
            "additionalProperties": false,
            "properties": {
              "kind": {"type": "string", "enum": ["environment", "building-block"], "description": "An assumption about the environment, or a building block the pattern relies on"},
              "statement": {"type": "string", "description": "The assumption in one sentence"},
              "pattern": {"type": "string", "pattern": "^SP-[0-9]{3}$", "description": "For a building block: the OSA pattern that provides it"},
              "removesThreats": {"type": "array", "items": {"type": "string"}, "description": "Ids of this pattern's threats that the assumption takes out of scope or hands to the building block"}
            },
            "if": {"properties": {"kind": {"const": "building-block"}}},
            "then": {"required": ["pattern"]}
          }
        }
      }
    },

    "examples": {
      "type": "object",
      "description": "Example implementations or services",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string"}
      }
    },

    "references": {
      "type": "array",
      "description": "External references and resources",
      "items": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": {"type": "string"},
          "url": {"type": "string", "format": "uri"},
          "note": {"type": "string"}
        }
      }
    },

    "relatedPatterns": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Related pattern IDs"
    },

    "relatedPatternNames": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Related pattern names (human-readable)"
    },

    "relatedPatternBoundaries": {
      "type": "object",
      "description": "One sentence per related pattern saying where this pattern stops and that one takes over, keyed by pattern ID",
      "propertyNames": {"pattern": "^SP-[0-9]{3}(\\.[0-9]+)?$"},
      "additionalProperties": {"type": "string"}
    },

    "controls": {
      "type": "array",
      "description": "NIST 800-53 controls applicable to this pattern",
      "items": {
        "type": "object",
        "required": ["id", "name", "family"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]{2}-[0-9]{2}$",
            "description": "NIST control identifier (e.g., AC-01)"
          },
          "name": {
            "type": "string",
            "description": "Control name"
          },
          "family": {
            "type": "string",
            "enum": ["AC", "AT", "AU", "CA", "CM", "CP", "IA", "IR", "MA", "MP", "PE", "PL", "PM", "PS", "PT", "RA", "SA", "SC", "SI", "SR"],
            "description": "NIST control family"
          },
          "emphasis": {
            "type": "string",
            "enum": ["critical", "important", "standard"],
            "description": "Relative importance for this pattern"
          },
          "scope": {
            "type": "string",
            "enum": ["inbound", "organisational"],
            "description": "Where the control applies, for patterns with an ArchiMate view: on the modelled call path (inbound) or at organisation level"
          },
          "functions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "enum": ["prevent", "detect", "respond"]},
            "description": "What the control does against the pattern's threats: prevents them, detects them, or supports the response. Lets an adopter choose a prevention-led or an assume-breach approach. Quality dimension 2, question 2.7"
          },
          "tier": {
            "type": "string",
            "enum": ["basic", "standard", "advanced"],
            "description": "The tier the control belongs to in this pattern, set by the threats it addresses. A small organisation starts with the basic tier. Quality dimension 2, question 2.6"
          },
          "effort": {
            "type": "string",
            "enum": ["low", "medium", "high"],
            "description": "Relative effort or cost of putting the control in place for this pattern. Quality dimension 2, question 2.4"
          }
        }
      }
    },

    "controlFamilySummary": {
      "type": "object",
      "description": "Count of controls by family",
      "additionalProperties": {"type": "integer"}
    },

    "complianceMappings": {
      "type": "object",
      "description": "Mappings to other compliance frameworks",
      "properties": {
        "iso27002": {
          "type": "array",
          "items": {"type": "string"},
          "description": "ISO 27002 control references"
        },
        "pciDss": {
          "type": "array",
          "items": {"type": "string"},
          "description": "PCI-DSS requirement references"
        },
        "cobit": {
          "type": "array",
          "items": {"type": "string"},
          "description": "COBIT control references"
        },
        "nistCsf": {
          "type": "array",
          "items": {"type": "string"},
          "description": "NIST Cybersecurity Framework references"
        },
        "cisControls": {
          "type": "array",
          "items": {"type": "string"},
          "description": "CIS Controls references"
        }
      }
    },

    "threats": {
      "type": "array",
      "description": "Specific threats addressed, each with the controls that mitigate it and, where given, its catalogue entry and its status once the pattern is applied",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "description": {"type": "string", "description": "Scenario: how the attack works, where it lands and which controls answer it"},
          "mitigatedBy": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Control IDs that mitigate this threat"
          },
          "owaspApi": {
            "type": "array",
            "items": {"type": "string", "pattern": "^API[0-9]{1,2}$"},
            "description": "OWASP API Security Top 10 (2023) entries this threat corresponds to"
          },
          "archimate": {
            "type": "object",
            "description": "The threat in the pattern's ArchiMate model that answers this one",
            "properties": {
              "threat": {"type": ["string", "null"], "description": "Threat name in the model (CAPEC meta attack pattern where one fits); null when the model does not cover it"},
              "strideLm": {"type": ["string", "null"], "description": "STRIDE-LM category"},
              "controls": {"type": "array", "items": {"type": "string"}, "description": "Controls the model draws as mitigating it"}
            }
          },
          "source": {
            "type": "string",
            "enum": ["osa", "archimate"],
            "description": "Where the threat comes from; osa when absent"
          },
          "catalogueRefs": {
            "type": "array",
            "description": "The threat's entries in named threat catalogues. MITRE ATT&CK is the default; CAPEC and BSI's elementary threats may be named as well. The validator checks ATT&CK ids against data/mitre-attack/enterprise-attack.json. Quality dimension 1, question 1.1",
            "items": {
              "type": "object",
              "required": ["catalogue", "id"],
              "additionalProperties": false,
              "properties": {
                "catalogue": {"type": "string", "enum": ["mitre-attack", "capec", "bsi-elementary"]},
                "id": {"type": "string", "description": "The entry's id in that catalogue: T1566 or T1566.001 for ATT&CK, CAPEC-112, G 0.18 for BSI"}
              },
              "allOf": [
                {"if": {"properties": {"catalogue": {"const": "mitre-attack"}}}, "then": {"properties": {"id": {"pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"}}}},
                {"if": {"properties": {"catalogue": {"const": "capec"}}}, "then": {"properties": {"id": {"pattern": "^CAPEC-[0-9]+$"}}}},
                {"if": {"properties": {"catalogue": {"const": "bsi-elementary"}}}, "then": {"properties": {"id": {"pattern": "^G 0\\.[0-9]{1,2}$"}}}}
              ]
            }
          },
          "status": {
            "type": "string",
            "enum": ["mitigated", "partially-mitigated", "residual"],
            "description": "The postcondition for this threat once the pattern is applied: the controls address it in full, reduce it with a stated gap, or leave it to the adopter. Quality dimension 1, question 1.4"
          },
          "reason": {
            "type": "string",
            "description": "Why the threat is partially mitigated or residual: cost, practicality, or out of the pattern's reach. Required with those two statuses"
          }
        },
        "if": {"required": ["status"], "properties": {"status": {"enum": ["partially-mitigated", "residual"]}}},
        "then": {"required": ["reason"]}
      }
    },

    "archimateView": {
      "type": "object",
      "description": "A contributed ArchiMate view of the pattern: the exchange-format model, one SVG per view, and the sidecar describing every element drawn",
      "required": ["name", "views", "contributor"],
      "properties": {
        "name": {"type": "string"},
        "alsoKnownAs": {"type": "string"},
        "version": {"type": "string"},
        "status": {"type": "string"},
        "scope": {"type": "string"},
        "contributor": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": {"type": "string"},
            "url": {"type": "string", "format": "uri"},
            "people": {"type": "array", "items": {"type": "string"}}
          }
        },
        "license": {"type": "string"},
        "model": {"type": "string", "description": "Exchange-format model, relative to data/"},
        "standards": {"type": "array", "items": {"type": "string"}},
        "intro": {"type": "string"},
        "overviewNote": {"type": "string", "description": "HTML: how to read the OSA overview diagram"},
        "views": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "label", "svg"],
            "properties": {
              "key": {"type": "string", "pattern": "^[a-z]+$"},
              "label": {"type": "string"},
              "svg": {"type": "string", "description": "Site path of the view SVG"},
              "description": {"type": "string", "description": "HTML: how to read the view"}
            }
          }
        },
        "sidecar": {"type": "string", "description": "Site path of the element sidecar JSON"},
        "download": {"type": "string", "description": "Site path of the exchange-format download"},
        "keyControlAreaServices": {
          "type": "array",
          "description": "Security services delivering each entry of content.keyControlAreas, in the same order",
          "items": {"type": "array", "items": {"type": "string"}}
        },
        "services": {
          "type": "object",
          "description": "Name of each security service code used in keyControlAreaServices and otherControls (e.g. STS-21)",
          "additionalProperties": {"type": "string"}
        },
        "otherControls": {
          "type": "object",
          "properties": {
            "controls": {"type": "array", "items": {"type": "string"}},
            "deliveredBy": {"type": "array", "items": {"type": "string"}}
          }
        },
        "notes": {
          "type": "object",
          "description": "What the view adds to a content section, keyed by section",
          "additionalProperties": {"type": "string"}
        },
        "knownUses": {"type": "array", "items": {"type": "string"}},
        "variants": {"type": "string"}
      }
    },

    "context": {
      "type": "object",
      "description": "Structured environmental context driving threat-led control selection (§3.1 pattern modernisation). References TDCE, TPE, TCSE, TACM, and THFM catalogues.",
      "properties": {
        "dataTypes": {
          "type": "array",
          "description": "Data types processed by this pattern (TDCE catalogue references)",
          "items": {
            "type": "object",
            "required": ["ref"],
            "additionalProperties": false,
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^TDCE-[A-Z]+-[0-9]{2}$",
                "description": "TDCE data type identifier (e.g., TDCE-PCI-01)"
              },
              "state": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["at-rest", "in-transit", "in-use"]
                },
                "minItems": 1,
                "uniqueItems": true,
                "description": "Data states relevant to this pattern"
              },
              "volume": {
                "type": "string",
                "enum": ["low", "medium", "high"],
                "description": "Relative data volume throughput"
              }
            }
          }
        },
        "protocols": {
          "type": "array",
          "description": "Protocols used on pattern boundaries (TPE catalogue references)",
          "items": {
            "type": "object",
            "required": ["ref"],
            "additionalProperties": false,
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^TPE-[A-Z]+-[0-9]{2}$",
                "description": "TPE protocol identifier (e.g., TPE-WEB-01)"
              },
              "boundary": {
                "type": "string",
                "enum": ["external", "internal", "dmz"],
                "description": "Network boundary where protocol is used"
              },
              "direction": {
                "type": "string",
                "enum": ["inbound", "outbound", "bidirectional"],
                "description": "Traffic direction"
              }
            }
          }
        },
        "cloudServices": {
          "type": "array",
          "description": "Cloud services used by this pattern. Reference either a specific TCSE entry (ref) or a provider-agnostic service model (serviceModel). The derivation engine resolves serviceModel to the organisation's chosen provider.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "anyOf": [
              {"required": ["ref"]},
              {"required": ["serviceModel"]}
            ],
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^TCSE-[A-Z0-9]+(-[A-Z0-9]+)?$",
                "description": "Specific TCSE cloud service identifier (e.g., TCSE-AWS-LAM). Use for outlier services with no multi-provider equivalent."
              },
              "serviceModel": {
                "type": "string",
                "enum": [
                  "compute-iaas",
                  "compute-faas",
                  "compute-caas",
                  "storage-object",
                  "identity",
                  "database-paas",
                  "database-saas",
                  "network",
                  "cdn-waf",
                  "saas-productivity",
                  "saas-business"
                ],
                "description": "Provider-agnostic service model category from TCSE catalogue. Resolves to the specific TCSE entry for the organisation's cloud provider."
              },
              "responsibility": {
                "type": "string",
                "enum": ["customer", "provider", "shared"],
                "description": "Shared responsibility model position"
              },
              "notes": {
                "type": "string",
                "description": "How this service is used in the pattern"
              }
            }
          }
        },
        "assetTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "uniqueItems": true,
          "description": "Freeform asset type tags (e.g., web-application, database, load-balancer)"
        },
        "adversaryProfile": {
          "type": "object",
          "description": "Adversary capability scoping (TACM reference)",
          "additionalProperties": false,
          "properties": {
            "minTier": {
              "type": "string",
              "pattern": "^TACM-T[1-5]$",
              "description": "Minimum TACM adversary tier this pattern should resist"
            },
            "relevantActorTypes": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "nation-state",
                  "cybercriminal",
                  "hacktivist",
                  "insider-malicious",
                  "insider-accidental",
                  "competitor",
                  "terrorist"
                ]
              },
              "uniqueItems": true,
              "description": "STIX 2.1 threat actor type vocabulary subset"
            }
          }
        },
        "regulatoryScope": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "Applicable regulatory frameworks (e.g., PCI-DSS, GDPR, NIS2, DORA)"
        },
        "humanFactors": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^THFM-[A-Z]+-[0-9]{2}$"
          },
          "uniqueItems": true,
          "description": "Relevant human factor classes (THFM catalogue references)"
        }
      }
    }
  }
}
